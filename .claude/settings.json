{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(cloudflared/*.json)",
      "Read(**/*.db)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(make prune:*)",
      "Bash(docker system prune:*)"
    ]
  }
}
