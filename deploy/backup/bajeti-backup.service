# Bajeti nightly database backup. Install with docs/runbooks/backup-install.md
# (replace @USER@ and @HOME@ when copying to /etc/systemd/system).
[Unit]
Description=Bajeti database backup
OnFailure=bajeti-backup-failure.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
# Optional file with S3_BUCKET, BACKUP_PING_URL and so on (mode 600). Missing file is fine.
EnvironmentFile=-@HOME@/.config/bajeti/backup.env
ExecStart=@HOME@/projects/bajeti/deploy/backup/backup.sh
TimeoutStartSec=15min
MemoryMax=256M
TasksMax=64
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@/projects/bajeti/data @HOME@/backups
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
