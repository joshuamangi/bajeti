# Copy to ~/.config/bajeti/backup.env on the Pi and chmod 600. Never commit the real file.

# Off-device copy. Leave empty to skip. The AWS credentials stay in ~/.aws, not here.
S3_BUCKET=s3://<your-bucket>

# Optional dead-man's-switch (for example a healthchecks.io check URL). Pinged on success and at
# <URL>/fail on failure; the monitoring service alerts you when a night is missed entirely.
#BACKUP_PING_URL=https://hc-ping.com/<uuid>

# Optional second copy, run with the file that leaves the Pi as "$1". Leave unset: the backup Pi
# PULLS the encrypted copies, so this Pi holds no credentials for it.
#BACKUP_COPY_COMMAND=

# Encrypt what leaves the Pi (public key only; the private key stays in your password manager).
# Encrypted copies go to ~/backups/outgoing, which the backup Pi pulls. Install age first (see
# docs/runbooks/backup-install.md, "Encryption").
#AGE_RECIPIENT=age1...
#AGE_BIN=/home/<USER>/.local/bin/age

#BACKUP_KEEP=365   # pruning deletes the oldest copies for good
#DB_PATH=/home/<USER>/projects/bajeti/data/db/data/bajeti.db
#BACKUP_DIR=/home/<USER>/backups/db_backups
