# Copy to ~/.config/bajeti/backup.env on the Pi and chmod 600. Never commit the real file.

# Off-device copy. Leave empty to skip. The AWS credentials stay in ~/.aws, not here.
S3_BUCKET=s3://<your-bucket>

# Optional dead-man's-switch (for example a healthchecks.io check URL). Pinged on success and at
# <URL>/fail on failure; the monitoring service alerts you when a night is missed entirely.
#BACKUP_PING_URL=https://hc-ping.com/<uuid>

# Optional second copy, run with the new file as "$1".
#BACKUP_COPY_COMMAND=rsync -a "$1" <USER>@<PI_BACKUP_HOST>:/srv/bajeti-backups/

#BACKUP_KEEP=30
#DB_PATH=/home/<USER>/projects/bajeti/data/db/data/bajeti.db
#BACKUP_DIR=/home/<USER>/backups/db_backups
