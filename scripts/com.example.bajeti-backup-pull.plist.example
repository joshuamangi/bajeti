<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/com.example.bajeti-backup-pull.plist, replace every PLACEHOLDER
     (PATH_TO_REPO, USER, PI_BACKUP_HOST, HOME), then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.bajeti-backup-pull.plist
     Undo: launchctl bootout gui/$(id -u)/com.example.bajeti-backup-pull
     A StartCalendarInterval job that was missed while the Mac slept runs once on wake. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.bajeti-backup-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>PATH_TO_REPO/scripts/mac-backup-pull.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BACKUP_SSH_TARGET</key><string>USER@PI_BACKUP_HOST</string>
    <key>DEST_DIR</key><string>HOME/BajetiBackups</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>HOME/Library/Logs/bajeti-backup-pull.log</string>
  <key>StandardErrorPath</key><string>HOME/Library/Logs/bajeti-backup-pull.log</string>
</dict>
</plist>
