#!/usr/sbin/nft -f
# Managed by Ansible. Default drop; SSH only from the listed addresses.
flush ruleset

table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    iif lo accept
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept
    tcp dport 22 ip saddr { {{ firewall_ssh_sources_backup | join(', ') }} } accept
{% for port in firewall_extra_tcp_ports_backup %}
    tcp dport {{ port }} accept
{% endfor %}
  }
  chain forward {
    type filter hook forward priority 0; policy drop;
  }
  chain output {
    type filter hook output priority 0; policy accept;
  }
}
